# Kopjoje këtë skedar si .env dhe plotëso vlerat. Mos e dërgo kurrë .env në GitHub.

# Adresa e dyqanit (përdoret në email-e)
SITE_URL=http://localhost:3000

# Email-et e administratorëve, të ndara me presje. Këta hyjnë te /admin dhe marrin njoftim për çdo porosi.
ADMIN_EMAILS=ti@shembull.com

# Email-i që klientët shohin te "Na shkruaj"
SUPPORT_EMAIL=info@unblej.com

# Resend (email). Pa këtë çelës, email-et ruhen te data/outbox për testim.
RESEND_API_KEY=
MAIL_FROM=unblej <no-reply@unblej.com>

# PayPal. Fillimisht "sandbox" për prova, pastaj "live" me çelësat e vërtetë.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Ku ruhet baza e të dhënave dhe fotot (në Render: /var/data)
# DATA_DIR=./data
